{{>layouts/header}}

<div class="edit-wrapper">
    <div class="mt-4 mb-3">
        <a href="/items" class="back-link">목록으로</a>
    </div>

    {{#item}}
        <div class="row">
            <div class="col-md-6">
                {{#imageName}}
                    <img src="/images/{{imageName}}" class="edit-img" alt="상품이미지">
                {{/imageName}}
                {{^imageName}}
                    <div class="img-placeholder-info">이미지 준비중</div>
                {{/imageName}}
            </div>

            <div class="col-md-6">
                <form action="/items/{{id}}/update" method="post">
                    <div class="mb-3">
                        <label class="label-bold">제목</label>
                        <input type="text" name="title" value="{{title}}" class="form-control mt-1">
                    </div>
                    <div class="mb-3">
                        <label class="label-bold">가격</label>
                        <input type="number" name="price" value="{{price}}" class="form-control mt-1">
                    </div>
                    <div class="mb-3">
                        <label class="label-bold">내용</label>
                        <textarea name="content" class="form-control mt-1" rows="6">{{content}}</textarea>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn w-100 btn-submit">수정완료</button>
                        <a href="/items/{{id}}/info" class="btn w-100 btn-cancel">취소</a>
                    </div>
                </form>
            </div>
        </div>
    {{/item}}
</div>

{{>layouts/footer}}