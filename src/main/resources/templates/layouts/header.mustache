<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>당균 마켓</title>
    <link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/css/items.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/info.css">
    <link rel="stylesheet" href="/css/edit.css">
    <style>
        .header {
            display: flex;
            align-items: center;
            padding: 0 20%;
            height: 80px;
            border-bottom: 1px solid #e5e5e5;
            background-color: #FF8A3D;
        }
        .header-logo {
            text-decoration: none;
            color: white;
            font-size: 40px;
            font-weight: 700;
            padding: 3px 10px;
            margin-left: 20px;
            font-family: 'Jua', sans-serif;
        }
        .header-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header-login {
            text-decoration: none;
            color: white;
            font-size: 25px;
            margin-right: 20px;
            white-space: nowrap;
            font-family: 'Jua', sans-serif;
        }
    </style>
</head>
<body>
<div class="header">
    <a href="/items" class="header-logo">당균</a>
    <div class="header-right">
        {{#logInUser}}
            <span class="header-login">{{logInUser}}님 환영해요!</span>
            <a href="/logout" class="header-login">로그아웃</a>
        {{/logInUser}}
        {{^logInUser}}
            <a href="/items/login" class="header-login">로그인</a>
        {{/logInUser}}
    </div>
</div>
{{#msg}}
    <div style="padding: 0 20%; margin-top: 10px;">
        <div class="alert alert-info alert-dismissible fade show" style="border-radius: 8px;">
            {{msg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
{{/msg}}
</body>
</html>