{{>layouts/header}}

<div class = "content">
    <div class="info-wrapper">
        <div class="mt-4 mb-3">
            <a href="/items" class="info-back-link">목록으로</a>
        </div>

        {{#item}}
            <div class="row">
                <div class="col-md-6">
                    {{#imageName}}
                        <img src="/images/{{imageName}}" class="info-img" alt="상품이미지">
                    {{/imageName}}
                    {{^imageName}}
                        <div class="info-img-placeholder">이미지 준비중</div>
                    {{/imageName}}
                </div>

                <div class="col-md-6">
                    <h3 class="info-title">{{title}}</h3>
                    <h4 class="info-price">{{price}}원</h4>
                    <hr>
                    <p class="info-content">{{content}}</p>
                    <hr>
                    <div class="d-flex gap-2 mt-4">
                        <a href="/items/{{id}}/buy" class="btn w-100 btn-buy">구매하기</a>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <a href="/items/{{id}}/edit" class="btn w-100 btn-edit">수정</a>
                        <a href="/items/{{id}}/delete" class="btn w-100 btn-delete">삭제</a>
                    </div>
                </div>
            </div>
        {{/item}}
    </div>
</div>

{{>layouts/footer}}


